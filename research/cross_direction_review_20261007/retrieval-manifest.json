    "title": "Lightweight Interpretable RGB-Guided Hyperspectral Super-Resolution under Real Cross-resolution Misalignment",
    "year": 2026,
    "doi": null,
    "arxiv_id": "2609.01060",
    "pmid": null,
    "pmcid": null,
    "raw_path": "D:\\coding\\github_self\\thesis_base_line\\research\\cross_direction_review_20261007\\fulltext\\arxiv_2609.01060\\raw.html",
