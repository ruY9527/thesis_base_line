# ============================
# 大文件 / 数据集（不上传远程仓库）
# ============================

# CAVE 高光谱数据集（约 2.9G），/ 开头锚定根目录，避免误伤 pf/code/CAVE/
/cave/

# 数据文件
*.mat
*.h5
*.hdf5
*.npy
*.npz
*.tiff
*.tfrecord

# ============================
# 模型权重 / 检查点
# ============================
*.pth
*.pt
*.pkl
*.ckpt
*.onnx
*.pb
*.weights
*.safetensors

# 保留记录文件（csv 很小，正常提交）
# pf/**/cave_record.csv 不受影响

# ============================
# Python
# ============================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# 虚拟环境
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# ============================
# 训练输出 / 日志
# ============================
runs/
logs/
outputs/
checkpoints/
wandb/
*.log
events.out.tfevents.*

# ============================
# IDE / 编辑器
# ============================
.idea/
.vscode/
*.swp
*.swo

# ============================
# 调研资料大文件（可再生的抓取产物，不上传）
# ============================
# 论文原文 PDF（research/**/raw.pdf、sources/**/source.pdf 等）
*.pdf

# 随调研脚本下载的第三方 Python 包二进制（pymupdf/PIL 等）
.deps/

# 抓取的网页原文（体积大，parsed.md / meta.json 已保留正文）
raw.html
source.html

# 从 HTML 抽取的原始图片（未被 parsed.md 引用；notes/ 下被笔记引用的图片不受影响）
research/**/fulltext/**/images/

# ============================
# 操作系统
# ============================
.DS_Store
Thumbs.db
desktop.ini
